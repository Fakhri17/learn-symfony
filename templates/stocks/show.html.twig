{% extends '_layouts/base.html.twig' %}

{% block title %}{{ stock.code }} - Stock Detail{% endblock %}

{% block body %}
    {% set isUp = change is not null and change >= 0 %}
    <a href="{{ path('app_stocks_index') }}" class="mb-6 inline-flex items-center gap-2 font-bold text-slate-600 transition hover:text-slate-950">&lt;- Kembali ke daftar saham</a>

    <section class="overflow-hidden rounded-3xl bg-slate-950 text-white shadow-2xl">
        <div class="grid gap-8 p-7 md:p-10 lg:grid-cols-[1.4fr_1fr]">
            <div>
                <div class="flex flex-wrap items-center gap-3"><h1 class="text-5xl font-black tracking-tight md:text-7xl">{{ stock.code }}</h1><span class="rounded-lg bg-white/10 px-3 py-2 text-sm font-bold text-slate-300">{{ stock.ticker ?: stock.code }}</span></div>
                <p class="mt-3 text-lg font-semibold text-slate-400">{{ stock.company and stock.company.name ? stock.company.name : 'Informasi perdagangan saham' }}</p>
                <div class="mt-10"><p class="text-sm font-bold uppercase tracking-[0.2em] text-slate-500">Harga terakhir</p><div class="mt-2 flex flex-wrap items-end gap-4"><p class="text-5xl font-black md:text-6xl">{{ stock.price|number_format(2, '.', ',') }}</p><span class="mb-1 text-sm font-bold text-slate-400">{{ stock.currency ?: '' }}</span></div></div>
                {% if change is not null %}<div class="mt-4 inline-flex items-center gap-2 rounded-xl px-4 py-2 font-black {{ isUp ? 'bg-emerald-400/15 text-emerald-300' : 'bg-red-400/15 text-red-300' }}"><span>{{ isUp ? 'Naik' : 'Turun' }}</span><span>{{ isUp ? '+' : '' }}{{ change|number_format(2, '.', ',') }}</span>{% if change_percentage is not null %}<span>({{ isUp ? '+' : '' }}{{ change_percentage|number_format(2) }}%)</span>{% endif %}</div>{% endif %}
            </div>
            <div class="grid grid-cols-2 gap-3 rounded-2xl border border-white/10 bg-white/5 p-5">
                {% set stats = [['Open', stock.openPrice], ['High', stock.highPrice], ['Low', stock.lowPrice], ['Volume', stock.volume], ['PE Ratio', stock.peRatio], ['EPS', stock.eps]] %}
                {% for stat in stats %}<div class="rounded-xl bg-slate-900 p-4"><p class="text-xs font-bold uppercase tracking-wider text-slate-500">{{ stat[0] }}</p><p class="mt-2 break-all text-lg font-black">{{ stat[1] is not null ? stat[1] : '-' }}</p></div>{% endfor %}
            </div>
        </div>
        <div class="border-t border-white/10 bg-white/5 px-7 py-4 text-sm font-semibold text-slate-400 md:px-10">Diperbarui {{ stock.marketTime ? stock.marketTime|date('d M Y H:i') : stock.fetchedAt|date('d M Y H:i') }} dari {{ stock.source }}</div>
    </section>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.5fr_1fr]">
        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm md:p-8">
            <div class="mb-6 flex items-end justify-between gap-4"><div><p class="text-xs font-bold uppercase tracking-widest text-slate-400">Price History</p><h2 class="text-2xl font-black text-slate-950">Riwayat harga terbaru</h2></div><span class="text-sm font-bold text-slate-400">{{ history|length }} snapshot</span></div>
            <div class="overflow-x-auto"><table class="w-full min-w-[520px] text-left"><thead class="border-b border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-400"><tr><th class="pb-3">Waktu</th><th class="pb-3 text-right">Harga</th><th class="pb-3 text-right">Open</th><th class="pb-3 text-right">Volume</th></tr></thead><tbody class="divide-y divide-slate-100">{% for item in history %}<tr><td class="py-4 font-semibold text-slate-600">{{ item.fetchedAt|date('d M Y H:i') }}</td><td class="py-4 text-right font-black text-slate-950">{{ item.price|number_format(2, '.', ',') }}</td><td class="py-4 text-right font-semibold text-slate-600">{{ item.openPrice is not null ? item.openPrice|number_format(2, '.', ',') : '-' }}</td><td class="py-4 text-right font-mono text-sm text-slate-500">{{ item.volume ?: '-' }}</td></tr>{% endfor %}</tbody></table></div>
        </section>
        <aside class="space-y-5">
            <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"><p class="text-xs font-bold uppercase tracking-widest text-slate-400">Market Cap</p><p class="mt-3 break-all text-3xl font-black text-slate-950">{{ stock.marketCap is not null ? stock.marketCap|number_format(0, '.', ',') : 'N/A' }}</p></div>
            <div class="rounded-3xl bg-emerald-100 p-6"><h2 class="text-xl font-black text-emerald-950">Ringkasan perdagangan</h2><p class="mt-3 font-semibold leading-relaxed text-emerald-900">Harga bergerak dari pembukaan {{ stock.openPrice is not null ? stock.openPrice|number_format(2, '.', ',') : '-' }} dengan rentang {{ stock.lowPrice is not null ? stock.lowPrice|number_format(2, '.', ',') : '-' }} sampai {{ stock.highPrice is not null ? stock.highPrice|number_format(2, '.', ',') : '-' }}.</p></div>
        </aside>
    </div>
{% endblock %}
