{% extends '_layouts/base.html.twig' %}

{% block title %}Stocks - Market Overview{% endblock %}

{% block body %}
    <section class="mb-10 overflow-hidden rounded-3xl bg-slate-950 p-7 text-white shadow-xl md:p-12">
        <div class="grid items-center gap-8 lg:grid-cols-[1.4fr_1fr]">
            <div>
                <span class="inline-flex rounded-full bg-emerald-400/15 px-4 py-2 text-xs font-bold uppercase tracking-[0.2em] text-emerald-300">Market Overview</span>
                <h1 class="mt-5 text-4xl font-black tracking-tight md:text-6xl">Pantau saham dalam satu layar.</h1>
                <p class="mt-4 max-w-2xl text-lg text-slate-300">Lihat harga terbaru, rentang perdagangan, volume, dan fundamental utama dari saham pilihan.</p>
            </div>
            <form method="get" class="rounded-2xl border border-white/10 bg-white/5 p-3 backdrop-blur">
                <label class="mb-2 block px-2 text-xs font-bold uppercase tracking-widest text-slate-400">Cari emiten</label>
                <div class="flex gap-2">
                    <input type="search" name="q" value="{{ search }}" placeholder="BBCA atau BBCA.JK" class="min-w-0 flex-1 rounded-xl border border-slate-700 bg-slate-900 px-4 py-3 font-bold uppercase text-white outline-none focus:border-emerald-400">
                    <button class="rounded-xl bg-emerald-400 px-5 py-3 font-black text-slate-950 transition hover:bg-emerald-300">Cari</button>
                </div>
            </form>
        </div>
    </section>

    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div><p class="text-sm font-bold uppercase tracking-widest text-slate-500">Daftar Saham</p><h2 class="text-3xl font-black text-slate-950">Harga terbaru</h2></div>
        <p class="rounded-full bg-slate-200 px-4 py-2 text-sm font-bold text-slate-700">{{ stocks|length }} saham</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {% for stock in stocks %}
            {% set difference = stock.price is not null and stock.openPrice is not null ? stock.price - stock.openPrice : null %}
            {% set isUp = difference is not null and difference >= 0 %}
            <a href="{{ path('app_stocks_show', {code: stock.code}) }}" class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-slate-300 hover:shadow-xl">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2"><h3 class="text-2xl font-black text-slate-950">{{ stock.code }}</h3><span class="rounded-md bg-slate-100 px-2 py-1 text-xs font-bold text-slate-500">{{ stock.currency ?: 'N/A' }}</span></div>
                        <p class="mt-1 text-sm font-semibold text-slate-500">{{ stock.company and stock.company.name ? stock.company.name : (stock.ticker ?: 'Listed stock') }}</p>
                    </div>
                    <span class="rounded-full bg-slate-100 p-3 text-slate-600 transition group-hover:bg-slate-950 group-hover:text-white">-&gt;</span>
                </div>
                <div class="mt-8 flex items-end justify-between gap-4">
                    <div><p class="text-xs font-bold uppercase tracking-widest text-slate-400">Last Price</p><p class="mt-1 text-3xl font-black text-slate-950">{{ stock.price|number_format(2, '.', ',') }}</p></div>
                    {% if difference is not null %}<span class="rounded-lg px-3 py-2 text-sm font-black {{ isUp ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' }}">{{ isUp ? '+' : '' }}{{ difference|number_format(2, '.', ',') }}</span>{% endif %}
                </div>
                <div class="mt-6 grid grid-cols-3 gap-3 border-t border-slate-100 pt-5 text-sm">
                    <div><p class="text-xs font-bold text-slate-400">OPEN</p><p class="mt-1 font-bold text-slate-700">{{ stock.openPrice is not null ? stock.openPrice|number_format(2, '.', ',') : '-' }}</p></div>
                    <div><p class="text-xs font-bold text-slate-400">HIGH</p><p class="mt-1 font-bold text-slate-700">{{ stock.highPrice is not null ? stock.highPrice|number_format(2, '.', ',') : '-' }}</p></div>
                    <div><p class="text-xs font-bold text-slate-400">LOW</p><p class="mt-1 font-bold text-slate-700">{{ stock.lowPrice is not null ? stock.lowPrice|number_format(2, '.', ',') : '-' }}</p></div>
                </div>
            </a>
        {% else %}
            <div class="col-span-full rounded-3xl border-2 border-dashed border-slate-300 bg-white p-16 text-center"><p class="text-2xl font-black text-slate-400">Data saham tidak ditemukan.</p>{% if search %}<a href="{{ path('app_stocks_index') }}" class="mt-4 inline-block font-bold text-emerald-700 underline">Tampilkan semua saham</a>{% endif %}</div>
        {% endfor %}
    </div>
{% endblock %}
