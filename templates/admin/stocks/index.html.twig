{% extends '_layouts/admin.html.twig' %}

{% block title %}Stock Data - Admin Panel{% endblock %}
{% block page_title %}Stock Data{% endblock %}

{% block body %}
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="mb-2 text-xs font-black uppercase tracking-[0.25em] text-gray-500">Market Data</p>
            <h1 class="text-3xl font-black uppercase tracking-tight md:text-5xl">Stock Inventory</h1>
            <p class="mt-2 max-w-2xl font-bold text-gray-600">100 snapshot staging terbaru untuk pemantauan hasil sinkronisasi data saham.</p>
        </div>
        <div class="border-4 border-black bg-yellow-300 px-5 py-3 font-black uppercase shadow-[5px_5px_0px_0px_rgba(0,0,0,1)]">{{ rows|length }} Records</div>
    </div>

    <form method="get" class="mb-8 grid gap-4 border-4 border-black bg-white p-5 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] md:grid-cols-4">
        <label class="block"><span class="mb-2 block text-xs font-black uppercase">Stock Code</span><input type="text" name="code" value="{{ filters.code }}" placeholder="BBCA" class="w-full border-2 border-black bg-[#f4f4f0] px-4 py-3 font-bold uppercase outline-none focus:bg-yellow-100"></label>
        <label class="block">
            <span class="mb-2 block text-xs font-black uppercase">Status</span>
            <select name="status" class="w-full border-2 border-black bg-[#f4f4f0] px-4 py-3 font-bold outline-none focus:bg-yellow-100">
                <option value="">All statuses</option>
                {% for status in ['success', 'partial', 'failed', 'pending'] %}<option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status|title }}</option>{% endfor %}
            </select>
        </label>
        <label class="block"><span class="mb-2 block text-xs font-black uppercase">Source</span><input type="text" name="source" value="{{ filters.source }}" placeholder="yahoo_finance" class="w-full border-2 border-black bg-[#f4f4f0] px-4 py-3 font-bold outline-none focus:bg-yellow-100"></label>
        <div class="flex items-end gap-3">
            <button class="flex-1 cursor-pointer border-2 border-black bg-indigo-300 px-4 py-3 font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none">Filter</button>
            <a href="{{ path('admin_stocks_index') }}" class="border-2 border-black bg-white px-4 py-3 font-black uppercase hover:bg-pink-200">Reset</a>
        </div>
    </form>

    <div class="overflow-hidden border-4 border-black bg-white shadow-[12px_12px_0px_0px_rgba(0,0,0,1)]">
        <div class="overflow-x-auto">
            <table class="w-full min-w-[1100px] border-collapse text-left">
                <thead class="border-b-4 border-black bg-indigo-300 text-xs font-black uppercase"><tr><th class="p-5">Stock</th><th class="p-5">Market</th><th class="p-5">Price Range</th><th class="p-5">Volume</th><th class="p-5">Fundamental</th><th class="p-5">Status</th><th class="p-5">Fetched At</th><th class="p-5 text-right">Action</th></tr></thead>
                <tbody class="divide-y-4 divide-black font-bold">
                    {% for row in rows %}
                        {% set statusClass = row.status == 'success' ? 'bg-lime-400' : (row.status == 'partial' ? 'bg-yellow-300' : (row.status == 'pending' ? 'bg-gray-300' : 'bg-red-400')) %}
                        <tr class="transition-colors hover:bg-yellow-50">
                            <td class="p-5">
                                {% if row.code %}<a href="{{ path('admin_stocks_show', {code: row.code}) }}" class="text-xl font-black uppercase underline decoration-4 decoration-indigo-400">{{ row.code }}</a>{% else %}<span class="text-gray-400">N/A</span>{% endif %}
                                <div class="mt-1 font-mono text-xs text-gray-500">{{ row.ticker ?: 'No ticker' }}</div>
                            </td>
                            <td class="p-5"><div>{{ row.source }}</div><div class="text-xs text-gray-500">{{ row.currency ?: 'N/A' }}</div></td>
                            <td class="p-5"><div class="text-lg font-black">{{ row.price is not null ? row.price|number_format(2, '.', ',') : 'N/A' }}</div><div class="text-xs text-gray-500">O {{ row.openPrice is not null ? row.openPrice|number_format(2, '.', ',') : '-' }} / H {{ row.highPrice is not null ? row.highPrice|number_format(2, '.', ',') : '-' }} / L {{ row.lowPrice is not null ? row.lowPrice|number_format(2, '.', ',') : '-' }}</div></td>
                            <td class="p-5 font-mono text-sm">{{ row.volume ?: 'N/A' }}</td>
                            <td class="p-5 text-sm"><div>PE {{ row.peRatio is not null ? row.peRatio|number_format(2) : '-' }}</div><div>EPS {{ row.eps is not null ? row.eps|number_format(2) : '-' }}</div></td>
                            <td class="p-5"><span class="{{ statusClass }} inline-block border-2 border-black px-3 py-1 text-xs font-black uppercase shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">{{ row.status }}</span>{% if row.missingFields %}<div class="mt-2 text-xs text-red-700">{{ row.missingFields|length }} missing fields</div>{% endif %}</td>
                            <td class="p-5 text-sm">{{ row.fetchedAt ? row.fetchedAt|date('d M Y H:i') : 'N/A' }}</td>
                            <td class="p-5 text-right">{% if row.code %}<a href="{{ path('admin_stocks_show', {code: row.code}) }}" class="inline-block border-2 border-black bg-white px-4 py-2 text-sm font-black uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none">Detail</a>{% endif %}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="8" class="p-16 text-center text-2xl font-black uppercase text-gray-400">No stock data matched the filters.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
